{
  "name": "rhizome-project",
  "version": "0.9.24",
  "private": true,
  "description": "An interactive, editable chart of Transformers G1 continuity, built as one self-contained page.",
  "type": "commonjs",
  "scripts": {
    "build": "python3 build.py",
    "pull": "python3 build.py --pull",
    "test": "node tests/regression.js",
    "test:src": "node tests/regression.js src",
    "lint": "python3 tools/lint.py",
    "test:build": "python3 tests/build_guard.py",
    "check:data": "python3 tools/data_check.py",
    "bench": "node tools/bench.js",
    "test:list": "node tests/regression.js --list",
    "test:fast": "node tools/shards.js"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "playwright": "^1.56.1"
  }
}
